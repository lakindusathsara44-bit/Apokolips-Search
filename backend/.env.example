# Backend-only secret. Never expose this as a VITE_* frontend variable.
BRAVE_SEARCH_API_KEY=

# ISO 3166-1 alpha-2 country used to bias Brave web results.
BRAVE_SEARCH_COUNTRY=LK

# Existing Apokolips first-party API configuration (optional for local development).
# APOKOLIPS_PUBLIC_MODE=false
# APOKOLIPS_ADMIN_TOKEN=
# APOKOLIPS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# APOKOLIPS_DB_PATH=backend/data/apokolips-search.sqlite3
